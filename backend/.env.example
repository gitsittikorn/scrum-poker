# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (อย่า commit .env)
#   cp .env.example .env

# ClickUp personal API token (Settings → Apps → API) — ใช้ยิง /api/clickup/*
# ไม่มีค่านี้ = backend ยังรันได้ แต่ทุก route เกี่ยวกับ ClickUp จะพัง
CLICKUP_API_TOKEN=

# (optional) ชื่อ custom field บนการ์ด ClickUp — default ตามด้านล่าง
# CLICKUP_DEV_POINT_FIELD_NAME=Dev Point Estimation (Original)
# CLICKUP_QA_POINT_FIELD_NAME=QA Point Estimation

# (optional — local dev) port ของ Express (default 3000)
# PORT=3000

# (optional) ฐาน URL ของ ClickUp API — default ใช้ของจริง
# ใช้ตอนรัน integration test (backend/test/) ชี้ไปที่ mock server บนเครื่อง
# CLICKUP_API_BASE=https://api.clickup.com/api/v2

# (optional — local dev) origin ที่อนุญาต CORS (คั่นหลายค่าด้วย comma)
# CORS_ORIGIN=http://localhost:5173
