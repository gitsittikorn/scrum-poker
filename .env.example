# คัดลอกไฟล์นี้เป็น .env (ที่ root — git-ignored แล้ว) แล้วใส่ค่าจริง
#   cp .env.example .env
#
# ไฟล์ env ที่เกี่ยวข้อง (โหลดโดย Vite, envDir = root ของ repo):
#   .env.development  — ค่า dev (commit ไว้ ไม่มี secret) โหลดเฉพาะ `pnpm dev`
#   .env.production   — ค่า prod (commit ไว้ ไม่มี secret) โหลดเฉพาะ `pnpm build`
#   .env              — ใช้ทั้ง dev/build สำหรับ secret ของเครื่องตัวเอง (อย่า commit)
#   .env.*.local      — override ระดับเครื่อง (git-ignored)

# Backend URL (ClickUp proxy) ที่ frontend ยิง — dev = Express บนเครื่อง
# production กำหนดไว้แล้วใน .env.production (ชี้ Render) — ตัวแปรนี้ใน .env
# จะโดน override ตอน build prod เสมอ
VITE_BACKEND_URL=http://localhost:3000

# AES-256-CBC สำหรับ QA Tool (super admin → tab QA Tool) — HEX เท่านั้น
#   ENCRYPTO_KEY = 64 ตัวอักษร hex (32 bytes)
#   ENCRYPTO_IV  = 32 ตัวอักษร hex (16 bytes)
#   สร้างค่าใหม่: node -e "console.log(require('crypto').randomBytes(32).toString('hex'), require('crypto').randomBytes(16).toString('hex'))"
# เป็น secret — ใส่ใน .env (หรือ .env.production.local ถ้าอยากให้ prod build มีด้วย) ห้าม commit
# ถ้าไม่ใส่: build ผ่าน แต่ปุ่ม AES ใน QA Tool จะกดไม่ได้ (ขึ้น error ตอนกด)
ENCRYPTO_KEY=<hex-64-chars>
ENCRYPTO_IV=<hex-32-chars>
