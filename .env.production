# Production build (vite build → mode=production) — commit ได้ เพราะไม่มี secret
# ไฟล์นี้ทำให้ build ซ้ำได้บนเครื่องไหนก็ได้ค่าเดิม โดยไม่ต้องพึ่ง env ในเครื่อง
# (.env.development โหลดเฉพาะ dev server — ก่อนหน้านี้ prod build เลยได้ undefined)

# Backend (ClickUp proxy) ที่ frontend ยิง — ปัจจุบัน backend จริงคือ Render
# (ตรงกับ bundle ที่ deploy อยู่บน Hosting ตอนนี้)
# ถ้า deploy Cloud Function `api` (rewrite /api/**) สำเร็จ สามารถเปลี่ยนเป็นค่าว่างได้
# เพื่อใช้ same-origin: VITE_BACKEND_URL=
VITE_BACKEND_URL=https://scrum-poker-backend-xxn5.onrender.com
